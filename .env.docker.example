# Copia este archivo a ".env" en la raiz del proyecto (mismo nivel que docker-compose.yml).
# Linux/macOS:  cp .env.docker.example .env
# Windows PS:   Copy-Item .env.docker.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=equipo13
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
JWT_SECRET=cambia-este-secreto-en-produccion

# --- Frontend ---
FRONTEND_PORT=5173

# --- ML service (Inteligencia de Ventas) ---
ML_PORT=8001
# El MISMO token debe quedar en backend y ml_service (si no, el backend recibe 401).
ML_SERVICE_TOKEN=pon-aqui-un-token-largo-y-secreto
